# ============================================================================
# LENOVO I9 AGENTICS ENV VARS
# ============================================================================
# Copy to .env.lenovo and fill in your credentials
# Load with: docker compose --env-file .env.lenovo
#
# Rules:
# - No NVIDIA, CUDA, or GPU settings
# - CPU-only Ollama with llama3.2:3b, qwen2.5-coder:7b, nomic-embed-text
# - Network: agentics_agentnet
# - Ports: 3000 (WebUI), 8787 (Dashboard), 8788 (Orchestrator), 11434 (Ollama)
# - NPU deferred to Phase 2+ as OpenVINO sidecar
#
# ============================================================================

# ============================================================================
# CORE DATABASE
# ============================================================================
POSTGRES_DB=openwebui
POSTGRES_USER=webui
POSTGRES_PASSWORD=your-secure-postgres-password-change-this
POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=en_US.UTF-8

# ============================================================================
# OLLAMA (CPU-ONLY)
# ============================================================================
# No NVIDIA device plugins — CPU inference only
OLLAMA_NUM_PARALLEL=1
OLLAMA_NUM_THREAD=0
OLLAMA_KEEP_ALIVE=10m
OLLAMA_KV_CACHE_TYPE=q8_0
CUDA_VISIBLE_DEVICES=-1
NVIDIA_VISIBLE_DEVICES=void

# Default models (pulled by start script)
OLLAMA_DEFAULT_MODEL=llama3.2:3b

# Ollama URLs
OLLAMA_BASE_URL=http://ollama-lenovo:11434
OLLAMA_API_BASE_URL=http://ollama-lenovo:11434/api
RAG_OLLAMA_BASE_URL=http://ollama-lenovo:11434

# ============================================================================
# OPEN WEBUI
# ============================================================================
WEBUI_SECRET_KEY=lenovo-cpu-npu-stack-secret-key
WEBUI_JWT_SECRET=lenovo-cpu-npu-jwt-secret
WEBUI_DEBUG=false
LOG_LEVEL=INFO

# RAG (Retrieval-Augmented Generation)
ENABLE_RAG=true
RAG_EMBEDDING_ENGINE=ollama
RAG_EMBEDDING_MODEL=nomic-embed-text

# LLM Capabilities
ENABLE_OLLAMA_API=true
ENABLE_FUNCTION_CALLING=true
ENABLE_IMAGE_GENERATION=false  # CPU-only, skip image generation

# Context
MAX_CONTEXT_LENGTH=2048
CHAT_RETENTION_DAYS=365

# Workers
UVICORN_WORKERS=1

# ============================================================================
# AGENTICS ORCHESTRATOR
# ============================================================================
ORCHESTRATOR_MODE=structured
STREAM_RESPONSES=false

# Models
ORCHESTRATOR_MODEL=llama3.2:3b
CODING_MODEL=qwen2.5-coder:7b

# Service URLs
N8N_URL=http://n8n:5678
TOOLS_API_URL=http://agentic-business-tools:3001
WEBUI_URL=http://open-webui:8080

# Docker socket (read-only, safer than TCP 2375)
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Logging
DEBUG=false

# ============================================================================
# N8N WORKFLOWS
# ============================================================================
N8N_SECURE_COOKIE=false
N8N_EDITOR_BASE_URL=http://localhost:5678

# ============================================================================
# AGENTIC BUSINESS TOOLS API
# ============================================================================
NODE_ENV=production
OLLAMA_MODEL=llama3.2:3b

# Shipping APIs
POSTNL_API_KEY=
POSTNL_CUSTOMER_CODE=

DHL_EXPRESS_API_KEY=
DHL_EXPRESS_ACCOUNT_NUMBER=

FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=

# Shopify
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Microsoft 365
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Enreach CRM
ENREACH_CLIENT_ID=
ENREACH_CLIENT_SECRET=

# ============================================================================
# BROWSER AUTOMATION
# ============================================================================
DISPLAY=:1
VNC_PASSWORD=password

# ============================================================================
# OBSERVABILITY
# ============================================================================
GF_SECURITY_ADMIN_PASSWORD=admin

# ============================================================================
# MINIO (Object Storage)
# ============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ============================================================================
# NPU PHASE 2+ (FUTURE)
# ============================================================================
# When ready to add OpenVINO NPU support:
# OPENVINO_DEVICE=NPU
# OPENVINO_MODEL_PATH=/path/to/converted/model
# OPENVINO_SERVICE_URL=http://openvino-sidecar:8000
