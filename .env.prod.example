# Agentics production environment
# Copy to .env and change passwords before first start.

OPEN_WEBUI_PORT=3000
BROWSER_VNC_PORT=6080
N8N_PORT=5678
GRAFANA_PORT=3002

WEBUI_NAME=Agentics Production
WEBUI_URL=http://127.0.0.1:3000

POSTGRES_PASSWORD=change_this_postgres_password
MINIO_ROOT_USER=agentics
RAG_EMBEDDING_MODEL=nomic-embed-text

GRAFANA_ADMIN_USER=admin

# Optional Tailscale
TS_AUTHKEY=
