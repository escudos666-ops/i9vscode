FROM node:22-alpine

# Install Chromium and dependencies
RUN apk add --no-cache \
    chromium \
    ca-certificates \
    dbus

# Install Puppeteer
WORKDIR /app
RUN npm init -y && \
    npm install puppeteer@latest

# Copy test script
COPY test-webui-tools.js .

# Run tests
CMD ["node", "test-webui-tools.js"]
