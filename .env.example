# OpenWebUI Enhanced Stack Secrets
# Copy this file to .env and update all secrets for production
# Note: Random values will be auto-generated by setup-full.sh, but manually set these for production:

# ============================================================================
# SECURITY SECRETS (CHANGE IN PRODUCTION!)
# ============================================================================
# These will be auto-generated by setup-full.sh if they contain "change-this-in-production"
WEBUI_SECRET_KEY=your-super-secret-key-change-this-in-production
WEBUI_JWT_SECRET=your-jwt-secret-change-this-in-production
PLAYWRIGHT_MCP_API_KEY=your-playwright-mcp-api-key-change-this
PLAYWRIGHT_PYTHON_IMAGE=mcr.microsoft.com/playwright/python:v1.49.1-jammy
WEBUI_AUTH=true
ENABLE_SIGNUP=false
REDIS_PASSWORD=your-redis-password-change-this-in-production
QDRANT_API_KEY=your-qdrant-api-key-change-this-in-production

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
POSTGRES_DB=openwebui
POSTGRES_USER=webui
POSTGRES_PASSWORD=your-postgres-password-change-this-in-production

# ============================================================================
# GRAFANA CONFIGURATION
# ============================================================================
# This will be auto-generated by setup-full.sh if it contains "change-this-in-production"
GRAFANA_PASSWORD=your-grafana-admin-password

# ============================================================================
# OLLAMA CONFIGURATION
# ============================================================================
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_NUM_PARALLEL=4
OLLAMA_NUM_THREAD=16
OLLAMA_KEEP_ALIVE=5m

# ============================================================================
# OPENWEBUI FEATURES
# ============================================================================
ENABLE_RAG=true
RAG_EMBEDDING_ENGINE=ollama
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_OLLAMA_BASE_URL=http://ollama:11434
ENABLE_IMAGE_GENERATION=true
ENABLE_FUNCTION_CALLING=true
MAX_CONTEXT_LENGTH=4096
CHAT_RETENTION_DAYS=365

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================
UVICORN_WORKERS=1
WEBUI_DEBUG=false
LOG_LEVEL=INFO

# ============================================================================
# OPTIONAL: OAuth (Google, GitHub, etc)
# ============================================================================
# WEBUI_OAUTH_GOOGLE_CLIENT_ID=your-google-oauth-id
# WEBUI_OAUTH_GOOGLE_CLIENT_SECRET=your-google-oauth-secret
# WEBUI_OAUTH_GITHUB_CLIENT_ID=your-github-oauth-id
# WEBUI_OAUTH_GITHUB_CLIENT_SECRET=your-github-oauth-secret
